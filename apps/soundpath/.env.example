# SoundPath environment variables

# Directory containing your Helix preset (.hlx) files. SoundPath reads the
# "active master" from here and writes aligned / edited versions back.
#
# On first run, the app will pick the first .hlx in this dir as the seed (or
# look for one named seed.hlx). Drop your exported preset here.
#
# Tip: point this at an iCloud/Dropbox folder if you want the file to sync
# between machines.
#
# Default when unset: ~/Documents/helix-presets/
SOUNDPATH_PRESET_DIR=

# SQLite database backing the generated-preset Library (shared catalog for
# SoundPath + HelAIx). Lives in the monorepo data/ dir alongside the other
# app databases. Path is relative to the soundpath app dir.
DATABASE_URL="file:../../data/soundpath.db"
